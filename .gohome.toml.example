# gohome Configuration File (TOML Format)

# Time period (only one should be set)
hours = 0
days = 1
weeks = 0
months = 0
years = 0
today = false

# Path and scanning
path = "."
max_depth = 2
author = ""

# Output formatting
format = "text"
style = "normal"
icon = false
scope = false

# Branch filtering
all_branches = false
branch = ""

# Clipboard
copy = false

# Static recurring tasks
# Set enabled = true for tasks you want to include in daily reports

[[tasks]]
type = "meeting"
message = "Daily Standup & Team Sync"
icon = "📅"
enabled = false

[[tasks]]
type = "collab"
message = "Pair Programming / Mentoring"
icon = "👥"
enabled = false

[[tasks]]
type = "review"
message = "Code Review & PR Feedback"
icon = "👀"
enabled = true

[[tasks]]
type = "testing"
message = "Write Unit/Integration Tests"
icon = "🧪"
enabled = false

[[tasks]]
type = "ops"
message = "Monitor CI/CD Pipelines & Deploy"
icon = "🚀"
enabled = false

[[tasks]]
type = "admin"
message = "Check Emails, Jira & Sentry Logs"
icon = "📮"
enabled = false

[[tasks]]
type = "docs"
message = "Update Documentation / Wiki"
icon = "📝"
enabled = false

[[tasks]]
type = "learning"
message = "Tech Research & Knowledge Sharing"
icon = "📚"
enabled = true
