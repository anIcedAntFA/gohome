# gohome Configuration File (YAML Format)

# Time period (only one should be set)
hours: 0
days: 1
weeks: 0
months: 0
years: 0
today: false

# Path and scanning
path: .
max_depth: 2
author: ""

# Output formatting
format: text
style: normal
icon: false
scope: false

# Branch filtering
all_branches: false
branch: ""

# Clipboard
copy: false

# Static recurring tasks
# Set enabled: true for tasks you want to include in daily reports
tasks:
  - type: meeting
    message: "Daily Standup & Team Sync"
    icon: "📅"
    enabled: false
    
  - type: collab
    message: "Pair Programming / Mentoring"
    icon: "👥"
    enabled: false
    
  - type: review
    message: "Code Review & PR Feedback"
    icon: "👀"
    enabled: true
    
  - type: testing
    message: "Write Unit/Integration Tests"
    icon: "🧪"
    enabled: false
    
  - type: ops
    message: "Monitor CI/CD Pipelines & Deploy"
    icon: "🚀"
    enabled: false
    
  - type: admin
    message: "Check Emails, Jira & Sentry Logs"
    icon: "📮"
    enabled: false
    
  - type: docs
    message: "Update Documentation / Wiki"
    icon: "📝"
    enabled: false
    
  - type: learning
    message: "Tech Research & Knowledge Sharing"
    icon: "📚"
    enabled: true
